model users {
  id                             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  role_id                        BigInt              @db.UnsignedBigInt
  full_name                      String              @db.VarChar(120)
  username                       String              @unique(map: "USERNAME") @db.VarChar(60)
  email                          String              @unique(map: "EMAIL") @db.VarChar(150)
  password_hash                  String              @db.VarChar(255)
  phone                          String?             @db.VarChar(20)
  is_active                      Boolean             @default(true)
  must_change_password           Boolean             @default(true)
  last_login_at                  DateTime?           @db.Timestamp(0)
  appointments                   appointments[]
  audit_logs                     audit_logs[]
  doctor_payments                doctor_payments[]
  doctor_sessions                doctor_sessions[]
  doctors                        doctors[]
  grn                            grn[]
  invoices                       invoices[]
  message_logs                   message_logs[]
  stock_movements                stock_movements[]
  employee_payments_as_employee  employee_payments[] @relation("EmployeePaymentsEmployee")
  employee_payments_as_processor employee_payments[] @relation("EmployeePaymentsProcessor")
  roles                          roles               @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "fk_users_role")
  visits                         visits[]
  refresh_tokens                 refresh_tokens[]
  insurance_claims               insurance_claims[]
  insurance_claim_documents      insurance_claim_documents[]

  @@index([role_id], map: "fk_users_role")
}

// One row per issued refresh token — lets a token be revoked individually
// (single logout) or in bulk (logout everywhere), and lets an admin/audit
// trail see active sessions. Only the SHA-256 hash is stored; the raw token
// only ever exists in the httpOnly cookie and briefly in memory here.
model refresh_tokens {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  token_hash String    @unique(map: "uq_refresh_tokens_hash") @db.VarChar(64)
  expires_at DateTime  @db.Timestamp(0)
  revoked_at DateTime? @db.Timestamp(0)
  user_agent String?   @db.VarChar(255)
  ip_address String?   @db.VarChar(45)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_refresh_tokens_user")

  @@index([user_id], map: "idx_refresh_tokens_user")
  @@index([expires_at], map: "idx_refresh_tokens_expires")
}

model employee_payments {
  id             BigInt                          @id @default(autoincrement()) @db.UnsignedBigInt
  payment_number String                          @unique(map: "uq_employee_payments_number") @db.VarChar(30)
  user_id        BigInt                          @db.UnsignedBigInt
  amount         Decimal                         @default(0.00) @db.Decimal(12, 2)
  payment_status doctor_payments_payment_status  @default(PENDING)
  payment_method doctor_payments_payment_method?
  period_start   DateTime?                       @db.Date
  period_end     DateTime?                       @db.Date
  paid_at        DateTime?                       @db.Timestamp(0)
  processed_by   BigInt?                         @db.UnsignedBigInt
  notes          String?                         @db.VarChar(255)
  created_at     DateTime                        @default(now()) @db.Timestamp(0)
  updated_at     DateTime                        @default(now()) @db.Timestamp(0)
  employee       users                           @relation("EmployeePaymentsEmployee", fields: [user_id], references: [id], onUpdate: Restrict, map: "fk_employee_payments_user")
  processor      users?                          @relation("EmployeePaymentsProcessor", fields: [processed_by], references: [id], onUpdate: Restrict, map: "fk_employee_payments_processor")

  @@index([user_id], map: "idx_employee_payments_user")
  @@index([processed_by], map: "fk_employee_payments_processor")
  @@index([payment_status], map: "idx_employee_payments_status")
}

model visits {
  id                      BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  appointment_id          BigInt          @unique(map: "uq_visits_appointment") @db.UnsignedBigInt
  session_id              BigInt          @db.UnsignedBigInt
  token_number            Int             @db.UnsignedInt
  status                  visits_status   @default(WAITING)
  checked_in_by           BigInt?         @db.UnsignedBigInt
  checked_in_at           DateTime        @default(now()) @db.Timestamp(0)
  consultation_started_at DateTime?       @db.Timestamp(0)
  consultation_ended_at   DateTime?       @db.Timestamp(0)
  created_at              DateTime        @default(now()) @db.Timestamp(0)
  updated_at              DateTime        @default(now()) @db.Timestamp(0)
  consultations           consultations?
  invoices                invoices[]
  appointments            appointments    @relation(fields: [appointment_id], references: [id], onUpdate: Restrict, map: "fk_visits_appointment")
  users                   users?          @relation(fields: [checked_in_by], references: [id], onUpdate: Restrict, map: "fk_visits_checkin_by")
  doctor_sessions         doctor_sessions @relation(fields: [session_id], references: [id], onUpdate: Restrict, map: "fk_visits_session")

  @@unique([session_id, token_number], map: "uq_visits_session_token")
  @@index([checked_in_by], map: "fk_visits_checkin_by")
  @@index([status], map: "idx_visits_status")
}

