  @@index([name], map: "idx_suppliers_name")
}

model test_orders {
  id                  BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  consultation_id     BigInt             @db.UnsignedBigInt
  test_id             BigInt             @db.UnsignedBigInt
  patient_id          BigInt             @db.UnsignedBigInt
  price_at_order      Decimal            @default(0.00) @db.Decimal(12, 2)
  status              test_orders_status @default(ORDERED)
  result_notes        String?            @db.Text
  ordered_at          DateTime           @default(now()) @db.Timestamp(0)
  sample_collected_at DateTime?          @db.Timestamp(0)
  completed_at        DateTime?          @db.Timestamp(0)
  report_file_path    String?            @db.VarChar(255)
  report_file_name    String?            @db.VarChar(255)
  uploaded_by         BigInt?            @db.UnsignedBigInt
  created_at          DateTime           @default(now()) @db.Timestamp(0)
  updated_at          DateTime           @default(now()) @db.Timestamp(0)
  consultations       consultations      @relation(fields: [consultation_id], references: [id], onUpdate: Restrict, map: "fk_test_orders_consultation")
  patients            patients           @relation(fields: [patient_id], references: [id], onUpdate: Restrict, map: "fk_test_orders_patient")
  diagnostic_tests    diagnostic_tests   @relation(fields: [test_id], references: [id], onUpdate: Restrict, map: "fk_test_orders_test")

  @@index([consultation_id], map: "idx_test_orders_consultation")
