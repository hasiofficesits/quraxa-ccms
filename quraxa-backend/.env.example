# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. This file documents what's required.

DATABASE_URL="mysql://user:password@localhost:3306/database_name"

# Generate a fresh random value for each environment — never reuse the same
# secret across dev/staging/prod, and never reuse this repo's old dev value.
# e.g. `openssl rand -hex 32`
JWT_SECRET=""
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="7"

# --- WhatsApp (Meta WhatsApp Cloud API) — optional ------------------------
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_ACCESS_TOKEN=""
META_WHATSAPP_API_VERSION="v21.0"

# --- Email (SMTP via Nodemailer) — optional -------------------------------
# For Gmail, use an App Password (not the account password), scoped only to
# mail sending and independently revocable.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Production hardening — all optional, unset = plain local HTTP dev ---
PORT="3000"
# Comma-separated list of allowed frontend origins in production.
FRONTEND_URL=""
# Only set to 1 if genuinely behind a reverse proxy (Nginx/Caddy/IIS).
TRUST_PROXY=""
# Direct-HTTPS mode — skip both if using a reverse proxy instead.
SSL_KEY_PATH=""
SSL_CERT_PATH=""
# Only needed if mysqldump isn't already on PATH on the server.
MYSQLDUMP_PATH=""
